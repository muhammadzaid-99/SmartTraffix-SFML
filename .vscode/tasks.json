{
  "version": "2.0.0",
  "tasks": [
      {
          "label": "Build with SFML",
          "type": "shell",
          "command": "g++",
          "args": [
              "-std=c++17",
              "-g",
              "${workspaceFolder}/src/*.cpp",
              "${workspaceFolder}/main.cpp",
              "-o",
              "${workspaceFolder}/build/SmartTraffix",
              "-I", "${workspaceFolder}/include",
              "-L", "${workspaceFolder}/lib",
              "-lsfml-graphics",
              "-lsfml-window",
              "-lsfml-system"
          ],
          "group": {
              "kind": "build",
              "isDefault": true
          },
          "problemMatcher": ["$gcc"],
          "detail": "Compile project with SFML."
      }
  ]
}
